# Copy to .env and fill in. .env is git-ignored; this template is committed.
# Single local user; secrets live here (see docs/decisions/0003-local-single-user-scope.md).

# ---- Postgres / pgvector ----
POSTGRES_USER=study
POSTGRES_PASSWORD=change-me
POSTGRES_DB=study_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string used by the app/services (host networking from the host machine).
DATABASE_URL=postgresql://study:change-me@localhost:5432/study_assistant
# Integration tests only. infra/postgres/init.sql creates this database.
TEST_DATABASE_URL=postgresql://study:change-me@localhost:5432/study_assistant_test

# ---- Embedding ----
# The model ingestion and retrieval embed with, and its vector dimension (docs/decisions/0010-*).
# Changing them selects another fastembed model with no code change; register it before use.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
# Put in front of every search query before embedding; the bge v1.5 model card recommends it.
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# Where fastembed keeps downloaded model files. Unset, it uses fastembed_cache in the system
# temporary folder, which the OS may clear.
# FASTEMBED_CACHE_PATH=

# ---- Reranking ----
# A cross-encoder rescores RERANK_CANDIDATES dense results and keeps the best (ADR 0010). On by
# default; set RERANK_ENABLED=false for dense search only. The MCP server reads these too.
# RERANK_ENABLED=true
# RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
# RERANK_CANDIDATES=20

# ---- Generation (the agent: study-ask and the agent eval) ----
# Any OpenAI-compatible chat-completions endpoint (docs/decisions/0011-free-hosted-generation.md).
# The default is Groq's free plan: create a key at console.groq.com and paste it below.
GENERATION_BASE_URL=https://api.groq.com/openai/v1
GENERATION_MODEL=qwen/qwen3.8-27b
GENERATION_API_KEY=
# Local alternative (Ollama). OpenAI clients need a non-empty key, which Ollama ignores.
# GENERATION_BASE_URL=http://localhost:11434/v1
# GENERATION_MODEL=qwen2.5:3b
# GENERATION_API_KEY=ollama
# Replies are cached here, keyed by the whole request, so a rerun with nothing changed is free.
# GENERATION_CACHE_DIR=.cache/generation
